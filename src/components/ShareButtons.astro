---
// Pulsanti di condivisione. Su mobile usa il menu nativo di condivisione del
// telefono (include Instagram, WhatsApp, Messaggi, ecc. — Instagram non ha un
// link di condivisione pubblico, compare solo così). Su desktop mostra un
// menu con Facebook, WhatsApp, X e "Copia link".
// 'variant': 'bar' (barra estesa, per la pagina dedicata) o 'icon' (bottone
// tondo compatto, per le card).
const { url, title, variant = 'bar', label = 'Condividi' } = Astro.props;
const uid = 'share-' + Math.random().toString(36).slice(2, 9);
---
<div class:list={['share', `share--${variant}`]} data-share-url={url} data-share-title={title} id={uid}>
  <button type="button" class="share-trigger" aria-haspopup="true" aria-expanded="false">
    <span class="share-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
        <path d="M8.6 10.5l6.8-3.9M8.6 13.5l6.8 3.9" />
      </svg>
    </span>
    {variant === 'bar' && <span>{label}</span>}
  </button>

  <div class="share-menu" role="menu" hidden>
    <a class="share-opt" data-net="facebook" target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">📘</span> Facebook
    </a>
    <a class="share-opt" data-net="whatsapp" target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">💬</span> WhatsApp
    </a>
    <a class="share-opt" data-net="x" target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">✕</span> X
    </a>
    <button type="button" class="share-opt share-copy" data-net="copy">
      <span aria-hidden="true">🔗</span> <span class="copy-label">Copia link</span>
    </button>
  </div>
</div>

<style>
  .share { position: relative; display: inline-block; }

  .share--bar .share-trigger {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--deep-forest); color: #fff; border: none; border-radius: 999px;
    padding: 0.7rem 1.3rem; font-weight: 600; font-size: 0.9rem; cursor: pointer;
    transition: background 0.15s ease;
  }
  .share--bar .share-trigger:hover { background: var(--growth-green); }

  .share--icon .share-trigger {
    width: 36px; height: 36px; display: grid; place-items: center;
    background: rgba(255,255,255,0.92); color: var(--deep-forest); border: none;
    border-radius: 999px; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .share--icon .share-trigger:hover { background: #fff; transform: scale(1.06); }

  .share-menu {
    position: absolute; top: calc(100% + 0.5rem); right: 0; z-index: 20;
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 16px 30px -14px rgba(26,92,56,0.45); padding: 0.4rem;
    display: flex; flex-direction: column; gap: 0.1rem; min-width: 170px;
  }
  .share-menu[hidden] { display: none; }
  .share-opt {
    display: flex; align-items: center; gap: 0.6rem; text-decoration: none;
    color: var(--ink); font-size: 0.88rem; padding: 0.55rem 0.7rem; border-radius: 8px;
    border: none; background: none; cursor: pointer; text-align: left; width: 100%;
    font-family: inherit;
  }
  .share-opt:hover { background: #eef5ec; }
</style>

<script define:vars={{ uid }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const url = root.dataset.shareUrl;
    const title = root.dataset.shareTitle || '';
    const trigger = root.querySelector('.share-trigger');
    const menu = root.querySelector('.share-menu');

    // Su mobile, se il browser supporta la condivisione nativa (include
    // Instagram, WhatsApp, Messaggi...), usiamo quella: è l'unico modo per
    // far comparire Instagram, che non ha un link di condivisione pubblico.
    const canNativeShare = typeof navigator !== 'undefined' && !!navigator.share;

    trigger.addEventListener('click', async () => {
      if (canNativeShare) {
        try {
          await navigator.share({ title, url });
          return;
        } catch (e) {
          // utente ha annullato o errore: si ricade sul menu
        }
      }
      const isHidden = menu.hasAttribute('hidden');
      if (isHidden) {
        menu.removeAttribute('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      } else {
        menu.setAttribute('hidden', '');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) {
        menu.setAttribute('hidden', '');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    const links = {
      facebook: () => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
      whatsapp: () => `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`,
      x: () => `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
    };

    root.querySelectorAll('.share-opt').forEach((el) => {
      const net = el.dataset.net;
      if (net === 'copy') {
        el.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            const label = el.querySelector('.copy-label');
            const original = label.textContent;
            label.textContent = 'Link copiato!';
            setTimeout(() => { label.textContent = original; }, 1800);
          } catch (e) {}
        });
      } else if (links[net]) {
        el.setAttribute('href', links[net]());
      }
    });
  })();
</script>
